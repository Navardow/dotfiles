{
  "theme": "auto",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(pwd)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(tree *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(readlink *)",
      "Bash(realpath *)",
      "Bash(diff *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(jq *)",
      "Bash(echo *)",
      "Bash(which *)",
      "Bash(command -v *)",
      "Bash(type *)",
      "Bash(whoami)",
      "Bash(uname *)",
      "Bash(date)",
      "Bash(ps *)",
      "Bash(printenv *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git remote -v)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -v)",
      "Bash(pacman -Q *)",
      "Bash(pacman -Qi *)",
      "Bash(pacman -Qs *)",
      "Bash(pacman -Si *)",
      "Bash(pacman -Ss *)",
      "Bash(systemctl status *)",
      "Bash(systemctl is-enabled *)",
      "Bash(systemctl is-active *)",
      "Bash(journalctl *)"
    ],
    "deny": [
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git add)",
      "Bash(git add *)",
      "Bash(git stage)",
      "Bash(git stage *)",
      "Bash(git -C * commit)",
      "Bash(git -C * commit *)",
      "Bash(git -C * add)",
      "Bash(git -C * add *)",
      "Bash(git -C * stage)",
      "Bash(git -C * stage *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git -C * rm *)",
      "Bash(git -C * mv *)"
    ],
    "ask": [
      "Edit",
      "Write",
      "NotebookEdit"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/block-shell-writes.sh" }
        ]
      }
    ]
  }
}
