{
    "memory": {
        "interval": 5,
        // icons next to text get rise='-3072' (4px lower) so they center on the numbers
        "format": "<span font='Material Symbols Rounded 12 @FILL=1,wght=500' rise='-3072'>memory_alt</span> {percentage}%",
        "format-alt": "<span font='Material Symbols Rounded 12 @FILL=1,wght=500' rise='-3072'>memory_alt</span> {used:0.1f}/{total:0.1f}G",
        "format-alt-click": "click-right",
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB used\nSwap: {swapUsed:0.1f} / {swapTotal:0.1f} GiB",
        "states": {
            "warning": 75,
            "critical": 90
        },
        "on-click": "~/.dotfiles/config/waybar/scripts/sysmon.sh mem"
    }
}
