{
    "include": [
        "~/.dotfiles/config/waybar/modules/workspaces.jsonc",
        "~/.dotfiles/config/waybar/modules/tray.jsonc",
        "~/.dotfiles/config/waybar/modules/battery.jsonc",
        "~/.dotfiles/config/waybar/modules/network.jsonc",
        "~/.dotfiles/config/waybar/modules/pulseaudio.jsonc",
        "~/.dotfiles/config/waybar/modules/cpu.jsonc",
        "~/.dotfiles/config/waybar/modules/memory.jsonc",
        "~/.dotfiles/config/waybar/modules/clock.jsonc",
        "~/.dotfiles/config/waybar/modules/mpris.jsonc",
        "~/.dotfiles/config/waybar/modules/bluetooth.jsonc",
        "~/.dotfiles/config/waybar/modules/temperature.jsonc"
    ],

    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar at the top of your screen
    "height": 30, // Waybar height
    "modules-left": ["niri/workspaces"],
    "modules-center": ["clock", "mpris"],
    "modules-right": [
        "group/traybox",
        "group/stats",
        "battery"
    ],
    "group/stats": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory", "temperature"]
    },
    "custom/notifications": {
        "exec": "~/.dotfiles/config/waybar/scripts/notifications.py status",
        "return-type": "json",
        "interval": 5,
        "signal": 9,
        "on-click": "~/.dotfiles/config/waybar/scripts/notifications.py list",
        "on-click-right": "~/.dotfiles/config/waybar/scripts/notifications.py dnd",
        "on-click-middle": "~/.dotfiles/config/waybar/scripts/notifications.py clear"
    },
    "group/traybox": {
        "orientation": "horizontal",
        "modules": ["tray", "custom/notifications", "bluetooth", "network", "pulseaudio"]
    }
}

