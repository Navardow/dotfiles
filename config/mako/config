font=Cozette 11
format=<b>%a ⏵</b> %s\n%b
sort=-time
layer=overlay
anchor=top-right
background-color=#000000
text-color=#ffffff
width=300
height=110
margin=5
padding=0,5,10
border-size=1
border-color=#3a3a3a
border-radius=10
icons=1
max-icon-size=32
default-timeout=10000
ignore-timeout=1
# history backs the waybar notification center (waybar/scripts/notifications.py)
max-history=100
on-notify=exec pkill -RTMIN+9 -x waybar

[urgency=high]
border-color=#ff0000
default-timeout=0

[mode=do-not-disturb]
invisible=1
